{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tinnhamnhi-site",
	"compatibility_date": "2026-09-01",

	// Không phục vụ site qua *.workers.dev để tránh trùng nội dung với tinnhamnhi.com
	"workers_dev": false,

	// Worker chỉ phục vụ file tĩnh: không có script, không có D1/R2.
	// Dữ liệu D1 và R2 cũ KHÔNG bị xoá, chỉ là không còn được gắn vào Worker nữa.
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		// URL chuẩn không có dấu "/" cuối, khớp với URL site cũ đã được index
		"html_handling": "drop-trailing-slash"
	}
}
