		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.7",
		"basic-ftp": "^5.0.5",
		"typescript": "^5.9.3",
		"wrangler": "^4.129.0"
	}
}
