---
import type { GetStaticPaths } from "astro";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";
import { site } from "../../site.config";
import { getAllTags, getPublishedPosts, tagSlug, type Post } from "../../utils/posts";

export const getStaticPaths: GetStaticPaths = async () => {
	const posts = await getPublishedPosts();
	const tags = await getAllTags();
	return tags.map((tag) => ({
		params: { slug: tag.slug },
		props: { tag, posts: posts.filter((p) => p.data.tags.some((t) => tagSlug(t) === tag.slug)) },
	}));
};

interface Props {
	tag: { slug: string; label: string; count: number };
	posts: Post[];
}

const { tag, posts } = Astro.props as Props;
---

<Base
	title={`#${tag.label}`}
	description={`Tổng hợp ${posts.length} bài viết về ${tag.label} trên ${site.title} — chuyện sức khoẻ, grooming, lối sống và những thứ nhảm nhí tử tế dành cho đàn ông.`}
	jsonLd={[{ "@type": "CollectionPage", name: `#${tag.label}` }]}
>
	<div class="wrap section">
		<header class="page-head">
			<p class="eyebrow">Thẻ</p>
			<h1 class="page-head__title">#{tag.label}</h1>
			<p class="page-head__sub">{posts.length} bài viết</p>
		</header>
		<div class="grid">
			{posts.map((post, i) => <PostCard post={post} priority={i === 0} />)}
		</div>
	</div>
</Base>

<style>
	.page-head {
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-4);
		border-bottom: 2px solid var(--text);
	}
	.page-head__title {
		font-size: var(--step-3);
		margin-top: var(--space-1);
	}
	.page-head__sub {
		margin-top: var(--space-2);
		color: var(--muted);
		font-size: var(--step--1);
	}
</style>
