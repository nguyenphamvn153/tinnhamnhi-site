---
import type { GetStaticPaths } from "astro";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";
import { categories, site, type Category } from "../../site.config";
import { getPublishedPosts, type Post } from "../../utils/posts";

export const getStaticPaths: GetStaticPaths = async () => {
	const posts = await getPublishedPosts();
	return categories.map((cat) => ({
		params: { slug: cat.slug },
		props: { cat, posts: posts.filter((p) => p.data.category === cat.slug) },
	}));
};

interface Props {
	cat: Category;
	posts: Post[];
}

const { cat, posts } = Astro.props as Props;
---

<Base
	title={cat.label}
	description={cat.description}
	jsonLd={[
		{ "@type": "CollectionPage", name: cat.label, description: cat.description },
		{
			"@type": "BreadcrumbList",
			itemListElement: [
				{ "@type": "ListItem", position: 1, name: "Trang chủ", item: `${site.url}/` },
				{ "@type": "ListItem", position: 2, name: cat.label, item: `${site.url}/category/${cat.slug}` },
			],
		},
	]}
>
	<div class="wrap section">
		<header class="page-head">
			<p class="eyebrow">Chuyên mục</p>
			<h1 class="page-head__title">{cat.label}</h1>
			<p class="page-head__sub">{cat.description}</p>
		</header>
		{
			posts.length > 0 ? (
				<div class="grid">
					{posts.map((post, i) => (
						<PostCard post={post} priority={i === 0} />
					))}
				</div>
			) : (
				<p>Chuyên mục này chưa có bài viết nào.</p>
			)
		}
	</div>
</Base>

<style>
	.page-head {
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-4);
		border-bottom: 2px solid var(--text);
	}
	.page-head__title {
		font-size: var(--step-3);
		margin-top: var(--space-1);
	}
	.page-head__sub {
		margin-top: var(--space-2);
		color: var(--text-secondary);
		max-width: 42rem;
	}
</style>
