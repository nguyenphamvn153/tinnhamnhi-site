---
import Badge from "../components/Badge.astro";
import Img from "../components/Img.astro";
import IndexRow from "../components/IndexRow.astro";
import PostCard from "../components/PostCard.astro";
import Base from "../layouts/Base.astro";
import { categories, categoryBySlug, site } from "../site.config";
import { formatDate, getPublishedPosts, readingTime } from "../utils/posts";

const posts = await getPublishedPosts();

/* Hero cần ảnh lớn, nên lấy bài mới nhất CÓ ảnh đại diện. */
const lead = posts.find((p) => p.data.featuredImage) ?? posts[0];
const rest = posts.filter((p) => p.id !== lead?.id);

const indexPosts = rest.slice(0, 5);
const shown = new Set([lead?.id, ...indexPosts.map((p) => p.id)]);
const odd = rest.filter((p) => !shown.has(p.id) && p.data.category === "chuyen-la").slice(0, 3);
const oddFill = odd.length >= 3 ? odd : [...odd, ...rest.filter((p) => !shown.has(p.id) && !odd.includes(p))].slice(0, 3);

const leadCat = lead?.data.category ? categoryBySlug.get(lead.data.category) : undefined;

/* Đếm số bài mỗi chuyên mục cho cột phải. */
const counts = new Map(categories.map((c) => [c.slug, posts.filter((p) => p.data.category === c.slug).length]));

/* "Đọc nhiều" chưa có số liệu thật — tạm lấy ba bài cũ hơn để lấp chỗ. */
const popular = rest.slice(-3).reverse();

/* Tách tiêu đề hero làm ba phần để phần giữa hiển thị dạng chữ viền rỗng. */
function splitTitle(t: string) {
	const words = t.split(" ");
	if (words.length < 6) return { a: t, b: "", c: "" };
	const start = Math.floor(words.length / 3);
	const end = Math.ceil((words.length * 2) / 3);
	return {
		a: words.slice(0, start).join(" "),
		b: words.slice(start, end).join(" "),
		c: words.slice(end).join(" "),
	};
}
const heroTitle = lead ? splitTitle(lead.data.title) : { a: "", b: "", c: "" };
---

<Base title={site.title} jsonLd={[{ "@type": "CollectionPage", "@id": `${site.url}/`, name: site.title }]}>
	{
		lead && (
			<section class="wrap hero">
				<div class="hero__head rise d3">
					{leadCat && <a href={`/category/${leadCat.slug}`} class="chip chip--active">{leadCat.label}</a>}
					<h1 class="hero__title">
						{heroTitle.a}{" "}
						<span class="hero__outline">{heroTitle.b}</span>{" "}
						{heroTitle.c}
					</h1>
					{lead.data.excerpt && <p class="hero__excerpt">{lead.data.excerpt}</p>}
				</div>

				<div class="hero__figure rise d4">
					{lead.data.featuredImage && (
						<a href={`/posts/${lead.id}`} class="hero__media" aria-label={lead.data.title}>
							<Img
								src={lead.data.featuredImage}
								alt={lead.data.featuredImageAlt ?? lead.data.title}
								sizes="(max-width: 75rem) 100vw, 1200px"
								loading="eager"
								fetchpriority="high"
								class="hero__img"
							/>
						</a>
					)}
					<a href={`/posts/${lead.id}`} class="hero__badge" aria-label={`Đọc bài: ${lead.data.title}`}>
						<Badge />
					</a>
				</div>

				<div class="meta hero__meta rise d5">
					{lead.data.publishedAt && (
						<time datetime={lead.data.publishedAt.toISOString()}>{formatDate(lead.data.publishedAt)}</time>
					)}
					<span class="meta__dot" />
					<span>{readingTime(lead.body)} phút đọc</span>
				</div>
			</section>
		)
	}

	<div class="wrap columns">
		<section>
			<div class="section__head rise d1">
				<h2 class="section__title">Chỉ mục</h2>
				<hr class="rule" />
				<span class="section__note">Mới nhất · {posts.length} bài</span>
			</div>
			<div class="index">
				{indexPosts.map((post, i) => <IndexRow post={post} n={i + 1} last={i === indexPosts.length - 1} />)}
			</div>
			<a href="/posts" class="chip index__all">Xem tất cả {posts.length} bài →</a>
		</section>

		<aside class="side">
			<div class="side__box">
				<span class="eyebrow">Chuyên mục</span>
				<div class="side__list">
					{
						categories.map((c) => (
							<a href={`/category/${c.slug}`} class="side__link">
								<span class="serif">{c.label}</span>
								<span class="side__count">{counts.get(c.slug)} bài</span>
							</a>
						))
					}
				</div>
			</div>

			{
				popular.length > 0 && (
					<div class="side__block">
						<div class="section__head side__head">
							<span class="eyebrow">Đáng đọc lại</span>
							<hr class="rule" />
						</div>
						{popular.map((p, i) => (
							<a href={`/posts/${p.id}`} class="side__pop">
								<span class="index-num side__pop-num">{i + 1}</span>
								<span class="serif side__pop-title"><span class="sweep">{p.data.title}</span></span>
							</a>
						))}
					</div>
				)
			}
		</aside>
	</div>

	{
		oddFill.length > 0 && (
			<section class="wrap section">
				<div class="section__head">
					<h2 class="section__title">Chuyện lạ</h2>
					<hr class="rule" />
					<span class="section__note">Thứ nhảm nhí nhưng có thật</span>
				</div>
				<div class="grid">
					{oddFill.map((post, i) => (
						<PostCard post={post} offset={(i % 3) as 0 | 1 | 2} />
					))}
				</div>
			</section>
		)
	}
</Base>

<style>
	.hero {
		padding-top: var(--space-6);
	}

	.hero__head {
		max-width: 54rem;
		margin-inline: auto;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--space-4);
	}

	.hero__title {
		font-size: var(--step-4);
		line-height: 1.26;
	}

	.hero__outline {
		color: transparent;
		-webkit-text-stroke: 1px var(--sage);
	}

	.hero__excerpt {
		font-size: var(--step-1);
		line-height: 1.75;
		color: var(--text-secondary);
	}

	.hero__figure {
		position: relative;
		margin-top: var(--space-5);
	}

	.hero__media {
		display: block;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--bg-subtle);
	}

	.hero__figure :global(.hero__img) {
		width: 100%;
		height: clamp(14rem, 40vw, 31rem);
		object-fit: cover;
		animation: tnn-ken 22s ease-in-out infinite alternate;
	}

	.hero__badge {
		position: absolute;
		right: var(--space-3);
		bottom: calc(-1 * var(--space-5));
		display: block;
	}

	.hero__meta {
		margin-top: var(--space-6);
	}

	@media (min-width: 48rem) {
		.hero__head {
			align-items: center;
			text-align: center;
		}
		.hero__badge {
			right: var(--space-6);
		}
	}

	.columns {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-7);
		margin-top: var(--space-8);
	}

	@media (min-width: 64rem) {
		.columns {
			grid-template-columns: minmax(0, 1fr) 20rem;
			gap: var(--space-8);
			align-items: start;
		}
	}

	.index {
		display: flex;
		flex-direction: column;
	}

	.index__all {
		margin-top: var(--space-5);
	}

	.side {
		display: flex;
		flex-direction: column;
		gap: var(--space-6);
	}

	.side__box {
		background: var(--bg-subtle);
		border-radius: var(--radius-xl);
		padding: var(--space-5);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.side__list {
		display: flex;
		flex-direction: column;
	}

	.side__link {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: var(--space-3);
		padding: var(--space-3) 0;
		font-size: var(--step-1);
	}

	.side__link:hover {
		color: var(--accent);
	}

	.side__count {
		font-size: var(--step--1);
		color: var(--muted);
	}

	.side__block {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.side__head {
		margin-bottom: 0;
	}

	.side__pop {
		display: flex;
		gap: var(--space-3);
		align-items: baseline;
	}

	.side__pop-num {
		font-size: 1.05rem;
		-webkit-text-stroke-color: var(--border-strong);
		width: 1.3rem;
		flex: none;
	}

	.side__pop-title {
		font-size: var(--step-0);
		line-height: 1.5;
	}
</style>
