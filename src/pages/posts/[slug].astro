---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Img from "../../components/Img.astro";
import HealthNotice from "../../components/HealthNotice.astro";
import PostCard from "../../components/PostCard.astro";
import Prose from "../../components/Prose.astro";
import Base from "../../layouts/Base.astro";
import { categoryBySlug, healthDisclaimerCategories, site } from "../../site.config";
import { formatDate, getPublishedPosts, readingTime, tagSlug, type Post } from "../../utils/posts";

export const getStaticPaths: GetStaticPaths = async () => {
	const posts = await getPublishedPosts();
	return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props as { post: Post };
const { title, metaTitle, excerpt, featuredImage, featuredImageAlt, featuredImageCredit, category, tags, publishedAt, updatedAt } = post.data;

const { Content, headings } = await render(post);
const cat = category ? categoryBySlug.get(category) : undefined;
const minutes = readingTime(post.body);
const url = new URL(`/posts/${post.id}`, site.url).href;

/** Bài liên quan: cùng chuyên mục trước, thiếu thì lấp bằng bài mới nhất. */
const all = await getPublishedPosts();
const sameCat = all.filter((p) => p.id !== post.id && p.data.category === category);
const related = [...sameCat, ...all.filter((p) => p.id !== post.id && !sameCat.includes(p))].slice(0, 3);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const needsHealthNotice = !!category && healthDisclaimerCategories.includes(category);

const description = excerpt ?? `${title} — ${site.title}`;
const shareText = encodeURIComponent(title);
const shareUrl = encodeURIComponent(url);

const jsonLd = [
	{
		"@type": "Article",
		headline: title,
		description,
		image: featuredImage ? new URL(featuredImage, site.url).href : undefined,
		datePublished: publishedAt?.toISOString(),
		dateModified: (updatedAt ?? publishedAt)?.toISOString(),
		author: { "@id": `${site.url}/#org` },
		publisher: { "@id": `${site.url}/#org` },
		mainEntityOfPage: { "@type": "WebPage", "@id": url },
		inLanguage: site.locale,
		keywords: tags.join(", ") || undefined,
	},
	{
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Trang chủ", item: `${site.url}/` },
			...(cat ? [{ "@type": "ListItem", position: 2, name: cat.label, item: `${site.url}/category/${cat.slug}` }] : []),
			{ "@type": "ListItem", position: cat ? 3 : 2, name: title, item: url },
		],
	},
];
---

<Base
	title={metaTitle ?? title}
	description={description}
	image={featuredImage}
	type="article"
	publishedTime={publishedAt?.toISOString() ?? null}
	modifiedTime={(updatedAt ?? publishedAt)?.toISOString() ?? null}
	jsonLd={jsonLd}
>
	<article>
		<div class="wrap article-head">
			<nav class="crumbs" aria-label="Đường dẫn">
				<a href="/">Trang chủ</a>
				{cat && <><span aria-hidden="true">/</span><a href={`/category/${cat.slug}`}>{cat.label}</a></>}
			</nav>
			<h1 class="article-title">{title}</h1>
			{excerpt && <p class="article-excerpt">{excerpt}</p>}
			<div class="meta">
				{publishedAt && <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>}
				<span class="meta__dot" />
				<span>{minutes} phút đọc</span>
			</div>
		</div>

		{
			featuredImage && (
				<div class="wrap">
					<div class="article-hero">
						<Img
							src={featuredImage}
							alt={featuredImageAlt ?? title}
							sizes="(max-width: 64rem) 100vw, 1100px"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					{featuredImageCredit && <p class="article-hero__credit">{featuredImageCredit}</p>}
				</div>
			)
		}

		<div class="wrap article-body">
			{
				toc.length > 2 && (
					<details class="toc">
						<summary class="toc__summary">Mục lục</summary>
						<ol class="toc__list">
							{toc.map((h) => (
								<li class={h.depth === 3 ? "toc__item toc__item--sub" : "toc__item"}>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ol>
					</details>
				)
			}

			<Prose>
				<Content />
			</Prose>

			{needsHealthNotice && <HealthNotice />}

			{
				tags.length > 0 && (
					<div class="article-tags">
						{tags.map((tag) => (
							<a href={`/tag/${tagSlug(tag)}`} class="chip">
								#{tag}
							</a>
						))}
					</div>
				)
			}

			<div class="share">
				<span class="share__label">Chia sẻ</span>
				<a
					class="chip"
					href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
					target="_blank"
					rel="noopener nofollow"
				>
					Facebook
				</a>
				<a
					class="chip"
					href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`}
					target="_blank"
					rel="noopener nofollow"
				>
					X
				</a>
				<button type="button" class="chip chip--button" data-copy-link data-url={url}>Chép liên kết</button>
			</div>
		</div>
	</article>

	{
		related.length > 0 && (
			<section class="wrap section">
				<div class="section__head">
					<h2 class="section__title">Đọc tiếp</h2>
				</div>
				<div class="grid">
					{related.map((p) => (
						<PostCard post={p} />
					))}
				</div>
			</section>
		)
	}
</Base>

<script is:inline>
	document.querySelector("[data-copy-link]")?.addEventListener("click", function (e) {
		var btn = e.currentTarget;
		navigator.clipboard?.writeText(btn.dataset.url).then(function () {
			var old = btn.textContent;
			btn.textContent = "Đã chép!";
			setTimeout(function () {
				btn.textContent = old;
			}, 1600);
		});
	});
</script>

<style>
	.article-head {
		max-width: var(--content-width);
		margin-top: var(--space-6);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		font-size: var(--step--1);
		font-weight: 700;
		color: var(--muted);
	}

	.crumbs a:hover {
		color: var(--accent);
	}

	.article-title {
		font-size: var(--step-3);
		line-height: 1.24;
	}

	.article-excerpt {
		font-size: var(--step-1);
		color: var(--text-secondary);
	}

	.article-hero {
		margin-block: var(--space-5);
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--bg-subtle);
	}

	.article-hero img {
		width: 100%;
		max-height: 32rem;
		object-fit: cover;
	}

	.article-hero__credit {
		margin: calc(-1 * var(--space-3)) 0 var(--space-5);
		font-size: var(--step--1);
		color: var(--muted);
		text-align: right;
	}

	.article-body {
		max-width: var(--content-width);
		margin-top: var(--space-5);
	}

	.toc {
		margin-bottom: var(--space-6);
		padding: var(--space-4) var(--space-5);
		border-radius: var(--radius-xl);
		background: var(--bg-subtle);
	}

	.toc__summary {
		font-weight: 700;
		cursor: pointer;
		font-size: var(--step-0);
	}

	.toc__list {
		margin: var(--space-3) 0 0;
		padding-left: 1.2em;
		font-size: var(--step--1);
		color: var(--text-secondary);
	}

	.toc__item + .toc__item {
		margin-top: var(--space-1);
	}

	.toc__item--sub {
		margin-left: var(--space-4);
		list-style: none;
	}

	.toc__list a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-6);
	}

	.share {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-5);
		padding-top: var(--space-5);
		border-top: 1px solid var(--border);
	}

	.share__label {
		font-size: var(--step--1);
		font-weight: 700;
		color: var(--muted);
		margin-right: var(--space-1);
	}

	.chip--button {
		font-family: inherit;
		border: 0;
		cursor: pointer;
	}
</style>
