---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Img from "../../components/Img.astro";
import HealthNotice from "../../components/HealthNotice.astro";
import PostCard from "../../components/PostCard.astro";
import Prose from "../../components/Prose.astro";
import Base from "../../layouts/Base.astro";
import { authorName, categoryBySlug, healthDisclaimerCategories, site } from "../../site.config";
import { formatDate, getPublishedPosts, readingTime, tagSlug, type Post } from "../../utils/posts";

export const getStaticPaths: GetStaticPaths = async () => {
	const posts = await getPublishedPosts();
	// posts xếp mới -> cũ, nên "bài sau" là bài cũ hơn và "bài trước" là bài mới hơn
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
	}));
};

const { post, newer, older } = Astro.props as { post: Post; newer: Post | null; older: Post | null };
const { title, metaTitle, excerpt, featuredImage, featuredImageAlt, featuredImageCredit, category, tags, publishedAt, updatedAt } = post.data;

const { Content, headings } = await render(post);
const cat = category ? categoryBySlug.get(category) : undefined;
const minutes = readingTime(post.body);
const url = new URL(`/posts/${post.id}`, site.url).href;

/** Bài liên quan: cùng chuyên mục trước, thiếu thì lấp bằng bài mới nhất. */
const all = await getPublishedPosts();
const sameCat = all.filter((p) => p.id !== post.id && p.data.category === category);
const related = [...sameCat, ...all.filter((p) => p.id !== post.id && !sameCat.includes(p))].slice(0, 3);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const needsHealthNotice = !!category && healthDisclaimerCategories.includes(category);

const description = excerpt ?? `${title} — ${site.title}`;
const shareText = encodeURIComponent(title);
const shareUrl = encodeURIComponent(url);

const jsonLd = [
	{
		"@type": "Article",
		headline: title,
		description,
		image: featuredImage ? new URL(featuredImage, site.url).href : undefined,
		datePublished: publishedAt?.toISOString(),
		dateModified: (updatedAt ?? publishedAt)?.toISOString(),
		author: { "@type": "Person", name: authorName, url: `${site.url}/pages/gioi-thieu` },
		publisher: { "@id": `${site.url}/#org` },
		mainEntityOfPage: { "@type": "WebPage", "@id": url },
		inLanguage: site.locale,
		keywords: tags.join(", ") || undefined,
	},
	{
		"@type": "BreadcrumbList",
		itemListElement: [
			{ "@type": "ListItem", position: 1, name: "Trang chủ", item: `${site.url}/` },
			...(cat ? [{ "@type": "ListItem", position: 2, name: cat.label, item: `${site.url}/category/${cat.slug}` }] : []),
			{ "@type": "ListItem", position: cat ? 3 : 2, name: title, item: url },
		],
	},
];
---

<Base
	title={metaTitle ?? title}
	description={description}
	image={featuredImage}
	type="article"
	publishedTime={publishedAt?.toISOString() ?? null}
	modifiedTime={(updatedAt ?? publishedAt)?.toISOString() ?? null}
	jsonLd={jsonLd}
>
	<article>
		<div class="wrap article-head">
			<nav class="crumbs" aria-label="Đường dẫn">
				<a href="/">Trang chủ</a>
				{cat && <><span aria-hidden="true">/</span><a href={`/category/${cat.slug}`}>{cat.label}</a></>}
			</nav>
			<h1 class="article-title">{title}</h1>
			{excerpt && <p class="article-excerpt">{excerpt}</p>}
			<div class="meta">
				{publishedAt && <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>}
				<span class="meta__dot" />
				<span>{minutes} phút đọc</span>
			</div>
		</div>

		{
			featuredImage && (
				<div class="wrap">
					<div class="article-hero">
						<Img
							src={featuredImage}
							alt={featuredImageAlt ?? title}
							sizes="(max-width: 64rem) 100vw, 1100px"
							loading="eager"
							fetchpriority="high"
						/>
					</div>
					{featuredImageCredit && <p class="article-hero__credit">{featuredImageCredit}</p>}
				</div>
			)
		}

		<div class="wrap article-layout">
		<div class="article-body">
			{
				toc.length > 2 && (
					<details class="toc toc--inline">
						<summary class="toc__summary">Mục lục</summary>
						<ol class="toc__list">
							{toc.map((h) => (
								<li class={h.depth === 3 ? "toc__item toc__item--sub" : "toc__item"}>
									<a href={`#${h.slug}`}>{h.text}</a>
								</li>
							))}
						</ol>
					</details>
				)
			}

			<Prose>
				<Content />
			</Prose>

			{needsHealthNotice && <HealthNotice />}

			{
				tags.length > 0 && (
					<div class="article-tags">
						{tags.map((tag) => (
							<a href={`/tag/${tagSlug(tag)}`} class="chip">
								#{tag}
							</a>
						))}
					</div>
				)
			}

			<div class="share">
				<span class="share__label">Chia sẻ</span>
				<button type="button" class="chip chip--button" data-native-share hidden>Chia sẻ…</button>
				<a
					class="chip"
					href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
					target="_blank"
					rel="noopener nofollow"
				>
					Facebook
				</a>
				<a
					class="chip"
					href={`https://sp.zalo.me/plugins/share?url=${shareUrl}`}
					target="_blank"
					rel="noopener nofollow"
				>
					Zalo
				</a>
				<button type="button" class="chip chip--button" data-copy-link data-url={url}>Chép liên kết</button>
			</div>

			{
				(newer || older) && (
					<nav class="pager" aria-label="Bài khác">
						{older ? (
							<a href={`/posts/${older.id}`} class="pager__item">
								<span class="pager__dir">← Bài cũ hơn</span>
								<span class="serif pager__title">{older.data.title}</span>
							</a>
						) : (
							<span />
						)}
						{newer ? (
							<a href={`/posts/${newer.id}`} class="pager__item pager__item--next">
								<span class="pager__dir">Bài mới hơn →</span>
								<span class="serif pager__title">{newer.data.title}</span>
							</a>
						) : (
							<span />
						)}
					</nav>
				)
			}
		</div>

		{
			toc.length > 2 && (
				<aside class="toc-rail" aria-label="Mục lục">
					<p class="toc-rail__title">Trong bài này</p>
					<ol class="toc-rail__list">
						{toc.map((h) => (
							<li class={h.depth === 3 ? "toc-rail__item toc-rail__item--sub" : "toc-rail__item"}>
								<a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
							</li>
						))}
					</ol>
				</aside>
			)
		}
		</div>
	</article>

	{
		related.length > 0 && (
			<section class="wrap section">
				<div class="section__head">
					<h2 class="section__title">Đọc tiếp</h2>
				</div>
				<div class="grid">
					{related.map((p) => (
						<PostCard post={p} />
					))}
				</div>
			</section>
		)
	}

	<dialog id="zoom" class="zoom" aria-label="Ảnh phóng to">
		<img alt="" />
	</dialog>

	<script is:inline>
		(function () {
			var url = location.href;
			var title = document.title;
	
			// Nút chia sẻ của hệ điều hành: mở được Zalo, Messenger, SMS... tuỳ máy người đọc
			var native = document.querySelector("[data-native-share]");
			if (native && navigator.share) {
				native.hidden = false;
				native.addEventListener("click", function () {
					navigator.share({ title: title, url: url }).catch(function () {});
				});
			}
	
			var copy = document.querySelector("[data-copy-link]");
			if (copy) {
				copy.addEventListener("click", function () {
					navigator.clipboard?.writeText(copy.dataset.url).then(function () {
						var old = copy.textContent;
						copy.textContent = "Đã chép!";
						setTimeout(function () { copy.textContent = old; }, 1600);
					});
				});
			}
	
			// Bấm vào ảnh trong bài để xem cỡ lớn
			var dlg = document.getElementById("zoom");
			if (dlg) {
				var big = dlg.querySelector("img");
				document.querySelectorAll(".prose img").forEach(function (img) {
					img.style.cursor = "zoom-in";
					img.addEventListener("click", function () {
						big.src = img.currentSrc || img.src;
						big.alt = img.alt || "";
						dlg.showModal();
					});
				});
				dlg.addEventListener("click", function () { dlg.close(); });
				dlg.addEventListener("close", function () { big.removeAttribute("src"); });
			}
	
			// Làm nổi mục đang đọc: chọn tiêu đề cuối cùng đã đi qua mép trên màn hình
			var links = document.querySelectorAll("[data-toc-link]");
			var heads = document.querySelectorAll(".prose h2[id], .prose h3[id]");
			if (links.length && heads.length) {
				var byId = {};
				links.forEach(function (a) { byId[a.dataset.tocLink] = a; });
				var ticking = false;
				var sync = function () {
					ticking = false;
					var current = heads[0];
					heads.forEach(function (h) {
						if (h.getBoundingClientRect().top < 140) current = h;
					});
					links.forEach(function (a) { a.classList.remove("is-active"); });
					var active = byId[current.id];
					if (active) active.classList.add("is-active");
				};
				var onScroll = function () {
					if (!ticking) { ticking = true; requestAnimationFrame(sync); }
				};
				addEventListener("scroll", onScroll, { passive: true });
				sync();
			}
	})();
	</script>
</Base>

<style>

	/* --- Bố cục có cột mục lục --- */
	.article-layout {
		display: grid;
		grid-template-columns: minmax(0, var(--content-width));
		justify-content: center;
		margin-top: var(--space-5);
	}

	.article-body {
		max-width: var(--content-width);
		min-width: 0;
	}

	.toc-rail {
		display: none;
	}

	@media (min-width: 75rem) {
		.article-layout {
			grid-template-columns: minmax(0, var(--content-width)) 15rem;
			gap: var(--space-7);
		}

		.toc-rail {
			display: block;
			position: sticky;
			top: calc(var(--header-height) + var(--space-5));
			align-self: start;
			max-height: calc(100vh - var(--header-height) - var(--space-7));
			overflow-y: auto;
		}

		/* Trên desktop đã có mục lục bên cạnh nên ẩn khối gập trong bài */
		.toc--inline {
			display: none;
		}
	}

	.toc-rail__title {
		font-size: var(--step--1);
		font-weight: 500;
		letter-spacing: 0.1em;
		color: var(--accent);
		margin-bottom: var(--space-3);
	}

	.toc-rail__list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-left: 1px solid var(--border);
	}

	.toc-rail__item a {
		display: block;
		padding: 0.4rem 0 0.4rem var(--space-4);
		margin-left: -1px;
		border-left: 2px solid transparent;
		font-size: var(--step--1);
		line-height: 1.5;
		color: var(--muted);
		transition: color 0.2s ease, border-color 0.2s ease;
	}

	.toc-rail__item--sub a {
		padding-left: var(--space-6);
		font-size: 0.8rem;
	}

	.toc-rail__item a:hover {
		color: var(--text);
	}

	.toc-rail__item a.is-active {
		color: var(--accent);
		border-left-color: var(--accent);
	}

	/* --- Bài trước / bài sau --- */
	.pager {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
		margin-top: var(--space-6);
		padding-top: var(--space-5);
		border-top: 1px solid var(--border);
	}

	.pager__item {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding: var(--space-4);
		border-radius: var(--radius-lg);
		background: var(--bg-subtle);
		transition: background 0.3s ease;
	}

	.pager__item:hover {
		background: var(--accent-soft);
	}

	.pager__dir {
		font-size: var(--step--1);
		color: var(--accent);
		font-weight: 500;
	}

	.pager__title {
		font-size: var(--step-0);
		line-height: 1.4;
		color: var(--text);
	}

	@media (min-width: 48rem) {
		.pager {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-4);
		}
		.pager__item--next {
			text-align: right;
		}
	}

	/* --- Ảnh phóng to --- */
	.zoom {
		max-width: 96vw;
		max-height: 96vh;
		padding: 0;
		border: 0;
		border-radius: var(--radius-lg);
		background: transparent;
		cursor: zoom-out;
	}

	.zoom::backdrop {
		background: rgba(23, 18, 15, 0.88);
	}

	.zoom img {
		display: block;
		max-width: 96vw;
		max-height: 96vh;
		width: auto;
		height: auto;
		border-radius: var(--radius-lg);
	}
	.article-head {
		max-width: var(--content-width);
		margin-top: var(--space-6);
		display: flex;
		flex-direction: column;
		gap: var(--space-3);
	}

	.crumbs {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		font-size: var(--step--1);
		font-weight: 700;
		color: var(--muted);
	}

	.crumbs a:hover {
		color: var(--accent);
	}

	.article-title {
		font-size: var(--step-3);
		line-height: 1.24;
	}

	.article-excerpt {
		font-size: var(--step-1);
		color: var(--text-secondary);
	}

	.article-hero {
		margin-block: var(--space-5);
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--bg-subtle);
	}

	.article-hero img {
		width: 100%;
		max-height: 32rem;
		object-fit: cover;
	}

	.article-hero__credit {
		margin: calc(-1 * var(--space-3)) 0 var(--space-5);
		font-size: var(--step--1);
		color: var(--muted);
		text-align: right;
	}

	.toc {
		margin-bottom: var(--space-6);
		padding: var(--space-4) var(--space-5);
		border-radius: var(--radius-xl);
		background: var(--bg-subtle);
	}

	.toc__summary {
		font-weight: 700;
		cursor: pointer;
		font-size: var(--step-0);
	}

	.toc__list {
		margin: var(--space-3) 0 0;
		padding-left: 1.2em;
		font-size: var(--step--1);
		color: var(--text-secondary);
	}

	.toc__item + .toc__item {
		margin-top: var(--space-1);
	}

	.toc__item--sub {
		margin-left: var(--space-4);
		list-style: none;
	}

	.toc__list a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.article-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-top: var(--space-6);
	}

	.share {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-5);
		padding-top: var(--space-5);
		border-top: 1px solid var(--border);
	}

	.share__label {
		font-size: var(--step--1);
		font-weight: 700;
		color: var(--muted);
		margin-right: var(--space-1);
	}

	.chip--button {
		font-family: inherit;
		border: 0;
		cursor: pointer;
	}
</style>
