---
import Pagination from "../../components/Pagination.astro";
import PostCard from "../../components/PostCard.astro";
import Base from "../../layouts/Base.astro";
import { POSTS_PER_PAGE, site } from "../../site.config";
import { getPublishedPosts } from "../../utils/posts";

const posts = await getPublishedPosts();
const pageSize = POSTS_PER_PAGE;
const first = posts.slice(0, pageSize);
const lastPage = Math.max(1, Math.ceil(posts.length / pageSize));
const page = { currentPage: 1, lastPage, url: { next: lastPage > 1 ? "/posts/trang/2" : undefined } };
---

<Base
	title="Tất cả bài viết"
	description={`Toàn bộ ${posts.length} bài viết trên ${site.title}, xếp theo thời gian đăng — sức khoẻ, grooming, lối sống, chuyện lạ và giải trí cho đàn ông.`}
	jsonLd={[{ "@type": "CollectionPage", name: "Tất cả bài viết" }]}
>
	<div class="wrap section">
		<header class="page-head">
			<h1 class="page-head__title">Tất cả bài viết</h1>
			<p class="page-head__sub">{posts.length} bài</p>
		</header>
		<div class="grid">
			{first.map((post, i) => <PostCard post={post} priority={i === 0} />)}
		</div>
		<Pagination page={page} />
	</div>
</Base>

<style>
	.page-head {
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-4);
		border-bottom: 2px solid var(--text);
	}
	.page-head__title {
		font-size: var(--step-3);
	}
	.page-head__sub {
		margin-top: var(--space-1);
		color: var(--muted);
		font-size: var(--step--1);
	}
</style>
