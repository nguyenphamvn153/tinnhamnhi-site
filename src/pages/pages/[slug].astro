---
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Prose from "../../components/Prose.astro";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../utils/posts";

export const getStaticPaths: GetStaticPaths = async () => {
	const pages = await getCollection("pages", ({ data }) => !data.draft);
	return pages.map((page) => ({ params: { slug: page.id }, props: { page } }));
};

const { page } = Astro.props as { page: CollectionEntry<"pages"> };
const { Content } = await render(page);
---

<Base title={page.data.title} description={page.data.excerpt} type="article">
	<article class="wrap static-page">
		<h1 class="static-page__title">{page.data.title}</h1>
		{page.data.updatedAt && (
			<p class="meta">Cập nhật {formatDate(page.data.updatedAt)}</p>
		)}
		<Prose>
			<Content />
		</Prose>
	</article>
</Base>

<style>
	.static-page {
		max-width: var(--content-width);
		margin-top: var(--space-6);
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}
	.static-page__title {
		font-size: var(--step-3);
	}
</style>
