---
import { Font } from "astro:assets";
import Marquee from "../components/Marquee.astro";
import { categories, site } from "../site.config";
import "../styles/theme.css";

interface Props {
	title: string;
	description?: string;
	image?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	noindex?: boolean;
	/** JSON-LD bổ sung cho từng loại trang. */
	jsonLd?: Record<string, unknown>[];
}

const {
	title,
	description = site.description,
	image = null,
	type = "website",
	publishedTime = null,
	modifiedTime = null,
	noindex = false,
	jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTitle = title === site.title ? `${site.title} — ${site.tagline}` : `${title} — ${site.title}`;
const ogImage = image ? new URL(image, site.url).href : new URL("/og-default.png", site.url).href;
const currentPath = Astro.url.pathname;

const graph = [
	{
		"@type": "Organization",
		"@id": `${site.url}/#org`,
		name: site.title,
		url: `${site.url}/`,
		description: site.description,
		logo: {
			"@type": "ImageObject",
			url: `${site.url}/logo-mascot.png`,
			width: 256,
			height: 256,
		},
	},
	{
		"@type": "WebSite",
		"@id": `${site.url}/#website`,
		url: `${site.url}/`,
		name: site.title,
		description: site.description,
		inLanguage: site.locale,
		publisher: { "@id": `${site.url}/#org` },
	},
	...jsonLd,
];

const marqueeText = "toàn tin nhảm nhí · chuyện sức khoẻ · grooming · lối sống · chuyện lạ có thật · từ 2019 · ";
---

<!doctype html>
<html lang={site.lang} data-theme="light">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- Đặt theme trước khi vẽ để không chớp nền -->
		<script is:inline>
			(function () {
				try {
					var saved = localStorage.getItem("theme");
					var dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
					document.documentElement.dataset.theme = dark ? "dark" : "light";
				} catch (e) {}
			})();
		</script>
		<Font cssVariable="--font-serif" preload />
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-display" />

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, follow" />}

		<meta property="og:site_name" content={site.title} />
		<meta property="og:type" content={type} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content="vi_VN" />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="theme-color" content="#faf7f1" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#17120f" media="(prefers-color-scheme: dark)" />

		<script type="application/ld+json" is:inline set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })} />
	</head>

	<body>
		<a href="#main" class="skip-link">Bỏ qua, tới nội dung chính</a>

		<header class="site-header rise d1">
			<div class="wrap site-header__bar">
				<a href="/" class="wordmark" aria-label={`${site.title} — trang chủ`}>
					<img src="/logo-96.webp" alt="" width="96" height="96" class="wordmark__mark" fetchpriority="high" decoding="async" />
					<span class="wordmark__text">
						<span class="serif wordmark__name">{site.title}</span>
						<span class="wordmark__tagline">{site.tagline}</span>
					</span>
				</a>

				<nav class="site-nav" aria-label="Chuyên mục">
					{
						categories.map((c) => (
							<a
								href={`/category/${c.slug}`}
								class:list={["chip", currentPath.startsWith(`/category/${c.slug}`) && "chip--active"]}
								aria-current={currentPath.startsWith(`/category/${c.slug}`) ? "page" : undefined}
							>
								{c.label}
							</a>
						))
					}
					<a href="/posts" class:list={["chip", currentPath === "/posts" && "chip--active"]}>Tất cả</a>
				</nav>

				<button type="button" class="theme-toggle" data-theme-toggle aria-label="Đổi giao diện sáng/tối">
					<svg class="theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
						<circle cx="12" cy="12" r="4"></circle>
						<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
					</svg>
					<svg class="theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
						<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
					</svg>
				</button>
			</div>
		</header>

		<nav class="site-nav-mobile rise d2" aria-label="Chuyên mục">
			<div class="wrap site-nav-mobile__scroll">
				{
					categories.map((c) => (
						<a
							href={`/category/${c.slug}`}
							class:list={["chip", currentPath.startsWith(`/category/${c.slug}`) && "chip--active"]}
							aria-current={currentPath.startsWith(`/category/${c.slug}`) ? "page" : undefined}
						>
							{c.label}
						</a>
					))
				}
				<a href="/posts" class:list={["chip", currentPath === "/posts" && "chip--active"]}>Tất cả</a>
			</div>
		</nav>

		<div class="rise d2">
			<Marquee text={marqueeText} />
		</div>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap site-footer__inner">
				<a href="/" class="wordmark">
					<img src="/logo-96.webp" alt="" width="96" height="96" class="wordmark__mark" loading="lazy" decoding="async" />
					<span class="serif wordmark__name">{site.title}</span>
				</a>
				<nav class="site-footer__links" aria-label="Liên kết chân trang">
					{categories.map((c) => <a href={`/category/${c.slug}`} class="chip">{c.label}</a>)}
					<a href="/pages/gioi-thieu" class="chip">Giới thiệu</a>
					<a href="/pages/lien-he" class="chip">Liên hệ</a>
					<a href="/pages/chinh-sach-bao-mat" class="chip">Bảo mật</a>
					<a href="/rss.xml" class="chip">RSS</a>
				</nav>
				<p class="site-footer__copy">© {new Date().getFullYear()} {site.title}</p>
			</div>
		</footer>

		<script is:inline>
			document.querySelector("[data-theme-toggle]")?.addEventListener("click", function () {
				var next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
				document.documentElement.dataset.theme = next;
				try {
					localStorage.setItem("theme", next);
				} catch (e) {}
			});
		</script>
	</body>
</html>

<style>
	.site-header__bar {
		display: flex;
		align-items: center;
		gap: var(--space-4);
		min-height: var(--header-height);
		padding-block: var(--space-3);
	}

	.wordmark {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		flex: none;
	}

	.wordmark__mark {
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 50%;
		background: var(--mascot-bg);
	}

	.wordmark__text {
		display: flex;
		flex-direction: column;
	}

	.wordmark__name {
		font-size: var(--step-2);
		font-weight: 600;
		line-height: 1.15;
		letter-spacing: -0.015em;
	}

	.wordmark__tagline {
		font-size: 0.75rem;
		color: var(--muted);
		margin-top: 1px;
	}

	.site-nav {
		display: none;
		align-items: center;
		gap: var(--space-1);
		margin-left: auto;
	}

	.theme-toggle {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		flex: none;
		margin-left: auto;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: var(--bg-subtle);
		color: var(--text-secondary);
		cursor: pointer;
		transition: background 0.2s ease, color 0.2s ease;
	}

	.site-nav + .theme-toggle {
		margin-left: 0;
	}

	.theme-toggle:hover {
		background: var(--accent-soft);
		color: var(--accent);
	}

	.theme-toggle__moon {
		display: none;
	}

	:global([data-theme="dark"]) .theme-toggle__sun {
		display: none;
	}

	:global([data-theme="dark"]) .theme-toggle__moon {
		display: block;
	}

	.site-nav-mobile {
		position: relative;
		padding-bottom: var(--space-3);
	}

	.site-nav-mobile__scroll {
		display: flex;
		gap: var(--space-2);
		overflow-x: auto;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
	}

	.site-nav-mobile__scroll::-webkit-scrollbar {
		display: none;
	}

	.site-nav-mobile .chip {
		flex: none;
	}

	/* Gợi ý còn nội dung bên phải khi dải chuyên mục tràn khỏi màn hình. */
	.site-nav-mobile::after {
		content: "";
		position: absolute;
		inset-block: 0;
		right: 0;
		width: 2.5rem;
		pointer-events: none;
		background: linear-gradient(to right, transparent, var(--bg));
	}

	@media (min-width: 60rem) {
		.site-nav {
			display: flex;
		}
		.site-nav-mobile {
			display: none;
		}
	}

	.site-footer {
		margin-top: var(--space-8);
		padding-block: var(--space-6) var(--space-7);
		background: var(--bg-subtle);
	}

	.site-footer__inner {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
	}

	.site-footer__links {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
	}

	.site-footer__links .chip {
		background: var(--bg);
	}

	.site-footer__copy {
		color: var(--muted);
		font-size: var(--step--1);
	}

	@media (min-width: 48rem) {
		.site-footer__inner {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
		}
	}
</style>
