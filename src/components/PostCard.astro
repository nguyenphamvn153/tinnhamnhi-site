---
import { categoryBySlug } from "../site.config";
import { formatDate, type Post } from "../utils/posts";
import Img from "./Img.astro";

interface Props {
	post: Post;
	/** Ảnh của card đầu tiên trên trang nên tải sớm (LCP). */
	priority?: boolean;
	showExcerpt?: boolean;
	/** Lệch nhẹ theo chiều dọc, dùng cho lưới "Chuyện lạ". */
	offset?: 0 | 1 | 2;
}

const { post, priority = false, showExcerpt = true, offset = 0 } = Astro.props;
const { title, excerpt, featuredImage, featuredImageAlt, category, publishedAt } = post.data;
const cat = category ? categoryBySlug.get(category) : undefined;
const href = `/posts/${post.id}`;
---

<article class:list={["card", !featuredImage && "card--text", offset > 0 && `card--offset-${offset}`]}>
	{
		featuredImage && (
			<a href={href} class="card__media" aria-hidden="true" tabindex="-1">
				<Img
					src={featuredImage}
					alt={featuredImageAlt ?? ""}
					sizes="(max-width: 34rem) 100vw, (max-width: 64rem) 50vw, 33vw"
					loading={priority ? "eager" : "lazy"}
					fetchpriority={priority ? "high" : undefined}
				/>
			</a>
		)
	}
	<div class="card__body">
		{cat && <a href={`/category/${cat.slug}`} class="eyebrow card__cat">{cat.label}</a>}
		<h3 class="card__title"><a href={href}><span class="sweep">{title}</span></a></h3>
		{showExcerpt && excerpt && <p class="card__excerpt">{excerpt}</p>}
		{publishedAt && (
			<div class="meta">
				<time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
			</div>
		)}
	</div>
</article>

<style>
	.card__body {
		display: flex;
		flex-direction: column;
		gap: var(--space-2);
	}

	.card__cat {
		align-self: flex-start;
		color: var(--sage);
	}

	/* Bài không có ảnh: dựa vào chữ, thêm gạch màu để vẫn có điểm nhấn thị giác. */
	.card--text {
		padding-left: var(--space-4);
		border-left: 2px solid var(--accent);
	}

	.card--text .card__title {
		font-size: var(--step-2);
	}

	@media (min-width: 64rem) {
		.card--offset-1 {
			margin-top: var(--space-6);
		}
		.card--offset-2 {
			margin-top: var(--space-4);
		}
	}
</style>
