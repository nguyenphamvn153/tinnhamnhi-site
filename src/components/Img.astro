---
/**
 * Ảnh responsive lấy từ media-manifest.json (do scripts/optimize-media.mjs sinh).
 * Luôn có width/height để không nhảy layout (CLS = 0).
 */
import manifest from "../data/media-manifest.json";

interface Props {
	src: string;
	alt?: string;
	sizes?: string;
	loading?: "lazy" | "eager";
	fetchpriority?: "high" | "low" | "auto";
	class?: string;
}

const { src, alt = "", sizes = "100vw", loading = "lazy", fetchpriority, class: className } = Astro.props;
const entry = (manifest as Record<string, { width: number; height: number; variants: { w: number; src: string }[] }>)[src];
const srcset = entry && entry.variants.length > 1 ? entry.variants.map((v) => `${v.src} ${v.w}w`).join(", ") : undefined;
---

<img
	src={src}
	srcset={srcset}
	sizes={srcset ? sizes : undefined}
	alt={alt}
	width={entry?.width}
	height={entry?.height}
	loading={loading}
	fetchpriority={fetchpriority}
	decoding="async"
	class={className}
/>
